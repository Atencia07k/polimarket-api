# Copie este archivo como .env y defina una contrasena segura (solo caracteres alfanumericos).
# .env es leido por Docker Compose y por Spring Boot (perfil dev). Nunca lo versione.
POSTGRES_DB=polimarket_db
POSTGRES_USER=polimarket
POSTGRES_PASSWORD=
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
# Primer administrador de la API: se crea al arrancar solo si no existe ningun ADMIN activo.
# Contrasena de 8 a 72 caracteres. Puede borrar estas dos lineas despues del primer arranque.
ADMIN_USERNAME=
ADMIN_PASSWORD=
# Opcional en dev (sin ellas se usan llaves efimeras); obligatorias en prod. Archivos PEM dentro de secrets/.
# JWT_PRIVATE_KEY_LOCATION=secrets/jwt-private.pem
# JWT_PUBLIC_KEY_LOCATION=secrets/jwt-public.pem