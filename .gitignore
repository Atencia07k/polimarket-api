# Gradle
.gradle/
build/
!gradle/wrapper/gradle-wrapper.jar
!**/src/main/**/build/
!**/src/test/**/build/

# Variables de entorno locales (contienen credenciales)
.env
.env.*
*.env
!.env.example

# Configuracion local con secretos (nunca versionar)
application-local.properties
application-*-local.properties
**/src/main/resources/application-secret*.properties
secrets/
polimarket-api-config*.zip
*.secret

# Llaves, certificados y almacenes de claves (JWT futuro, TLS)
*.pem
*.key
*.crt
*.p12
*.pfx
*.jks
*.keystore
*.truststore

# Volcados y respaldos de base de datos (pueden contener datos reales)
*.dump
*.backup
*.sql.gz
dumps/

# IntelliJ IDEA
.idea/
*.iws
*.iml
*.ipr
out/
!**/src/main/**/out/
!**/src/test/**/out/

# Eclipse / VS Code
.apt_generated
.classpath
.factorypath
.project
.settings
.springBeans
.sts4-cache
bin/
!**/src/main/**/bin/
!**/src/test/**/bin/
.vscode/

# Sistema operativo, OneDrive y logs
.DS_Store
Thumbs.db
desktop.ini
~$*
*.tmp
*.log
logs/
HELP.md
# Clientes
**/.dart_tool/
**/.flutter-plugins-dependencies
**/local.properties
**/__pycache__/
